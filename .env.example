MAGI_PORT=9100
MAGI_TOKEN=change-me
MAGI_SESSIONS='[{"id":"dev","name":"Dev Shell","shell":"bash","args":[],"cwd":"/home/user"}]'
MAGI_LOG_LEVEL=info

# STT (Speech-to-Text) — Phase 1
# Set MAGI_STT_ENABLED=true to enable voice input
MAGI_STT_ENABLED=false
MAGI_STT_PROJECT_ID=your-gcp-project
MAGI_STT_KEY_FILE=/path/to/service-account.json
MAGI_STT_MODEL=latest_long
MAGI_STT_LANGUAGE=en-US
# MAGI_STT_PHRASE_HINTS=kubectl,terraform,docker

# Command classification
MAGI_AUTO_SEND_CONFIDENCE=0.9
